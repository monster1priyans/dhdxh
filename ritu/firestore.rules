rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function prof(pid) { return get(/databases/$(database)/documents/profiles/$(pid)).data; }
    function isMember(pid) { return signedIn() && me() in prof(pid).memberUids; }
    function isOwner(pid) { return signedIn() && prof(pid).ownerUid == me(); }
    function canEdit(pid) { return isMember(pid) && prof(pid).members[me()].role in ['owner', 'editor']; }
    function fullAccess(pid) { return isMember(pid) && prof(pid).members[me()].scope == 'full'; }
    function validMembers(d) {
      return d.memberUids is list && d.members is map
        && d.members.keys().hasAll(d.memberUids)
        && d.members.size() == d.memberUids.size()
        && d.ownerUid in d.memberUids
        && d.members[d.ownerUid].role == 'owner'
        && d.members[d.ownerUid].scope == 'full';
    }

    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
      match /reminders/{rid} {
        allow read, write: if signedIn() && me() == uid;
      }
    }

    match /profiles/{pid} {
      allow read: if signedIn() && me() in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.ownerUid == me()
        && request.resource.data.memberUids == [me()]
        && validMembers(request.resource.data);

      // owner: anything except giving ownership away (only Cloud Functions do that)
      allow update: if signedIn()
        && resource.data.ownerUid == me()
        && request.resource.data.ownerUid == me()
        && validMembers(request.resource.data);

      // editor: profile fields only, never access or privacy settings
      allow update: if signedIn()
        && me() in resource.data.memberUids
        && resource.data.members[me()].role == 'editor'
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['ownerUid', 'members', 'memberUids', 'isManaged', 'discreet', 'showFertility']);

      // owner deletes the subcollections first, then this doc
      allow delete: if signedIn() && resource.data.ownerUid == me();

      match /periods/{id} {
        allow read: if fullAccess(pid);
        allow write: if canEdit(pid);
      }
      match /logs/{date} {
        allow read: if fullAccess(pid);
        allow write: if canEdit(pid) && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      match /private/{date} {
        allow read, write: if isOwner(pid);
      }
      match /activity/{id} {
        allow read, delete: if isOwner(pid);
        allow create: if isMember(pid) && request.resource.data.actorUid == me();
      }
    }

    match /invites/{token} {
      allow create: if signedIn()
        && request.resource.data.createdBy == me()
        && isOwner(request.resource.data.pid)
        && request.resource.data.usedBy == null
        && request.resource.data.expiresAt < request.time + duration.value(7, 'd')
        && ((request.resource.data.type == 'claim' && prof(request.resource.data.pid).isManaged == true)
          || (request.resource.data.type == 'share'
            && request.resource.data.role in ['editor', 'viewer']
            && request.resource.data.scope in ['full', 'predictions_only']));
      allow read, delete: if signedIn() && resource.data.createdBy == me();
    }

    match /transfers/{token} {
      allow read, write: if false;
    }
  }
}
